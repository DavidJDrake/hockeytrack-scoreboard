# The unit for an appliance image. Not a template: an image cannot know the
# owner's username, because Raspberry Pi OS renames the first account on first
# boot precisely so images do not ship a default one. So the service gets an
# account of its own, and the human login account has nothing to do with it.
#
# device/scoreboard.service remains the template for a git checkout, where
# ProtectHome and ProtectSystem=strict would break a checkout under /home.

[Unit]
Description=HockeyTrack scoreboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scoreboard
Group=scoreboard
# No SupplementaryGroups= here: systemd applies User='s own /etc/group
# memberships via initgroups without being told to, and tools/pi-setup.sh's
# install_appliance is what puts scoreboard into video, render, input and
# (if present) gpio. Declaring the same groups here too would let this file
# and the installer disagree about which ones are optional -- as they used
# to -- and systemd fails a unit outright (216/GROUP) if a name it's told to
# resolve does not exist, which is a worse failure than the installer simply
# not adding a group that isn't there.
WorkingDirectory=/opt/scoreboard
Environment=SDL_VIDEODRIVER=kmsdrm
# The panel has no sound hardware and the program plays nothing, but
# pygame.init() initializes the mixer anyway, and ALSA then prints about
# fifteen "cannot find card '0'" lines on every start. The journal is
# persistent now and is the only place a startup failure can be read once
# this service owns tty1 -- and while it is failing it restarts every 3 s, so
# that noise buries the one line worth reading. Remove this only if the
# scoreboard ever plays a sound; device/tests/test_pi_setup.py fails the
# moment it starts to.
Environment=SDL_AUDIODRIVER=dummy
# Which 2D renderer SDL emulates the window surface with. Without this the
# panel is SOLID BLACK while the program runs perfectly: v0.1.2 booted, drew
# for fifteen minutes and logged every frame; the next boot changed nothing
# but these two variables (passed on the kernel command line with
# systemd.setenv=) and the panel painted. docs/hardware-checks.md, H1.
#
# SDL 2.32.4, read rather than recalled. pygame's non-OpenGL set_mode ends in
# SDL_GetWindowSurface -> SDL_CreateWindowFramebuffer (SDL_video.c:2708), and
# on kmsdrm ShouldAttemptTextureFramebuffer() is true, so the surface is
# emulated with a 2D renderer by SDL_CreateWindowTexture (SDL_video.c:230).
# With no hint that walks render_drivers[] in order (SDL_render.c:100), where
# "opengl" is listed before "opengles2". This image ships no libGL.so.1 on
# purpose, so the "opengl" attempt must fail -- and failing is not free: it
# tears the kmsdrm window down and rebuilds it twice (SDL_render_gl.c:1726
# and :1943), each destroy pointing the CRTC back at the original TTY buffer
# and dropping DRM master (KMSDRM_DestroySurfaces, KMSDRM_GBMDeinit). Naming
# the renderer skips that attempt entirely.
#
# Either variable alone satisfies SDL_CreateWindowTexture, which reads
# SDL_FRAMEBUFFER_ACCELERATION first and falls back to SDL_RENDER_DRIVER.
# Both are set because both together are what a real boot proved; checking
# whether one would do costs a 35-minute build and somebody reflashing a card
# at night, and buys nothing.
#
# The trade, also from the source: when a renderer IS named and cannot be
# created, SDL_CreateWindowTexture returns -1 with no fallback, kmsdrm has no
# CreateWindowFramebuffer of its own, and set_mode raises instead of handing
# back a surface. That is the better failure -- a line in the journal rather
# than a black screen with nothing to explain it.
Environment=SDL_FRAMEBUFFER_ACCELERATION=opengles2
Environment=SDL_RENDER_DRIVER=opengles2
Environment=PYTHONUNBUFFERED=1
Environment=SCOREBOARD_CONFIG_DIR=/var/lib/scoreboard
ExecStart=/opt/scoreboard/.venv/bin/python -m scoreboard.main
Restart=always
RestartSec=3
# 78 is EX_CONFIG: a failure a restart cannot fix, chiefly a pygame whose SDL
# has no kmsdrm driver. Stop, and leave the reason at the end of the journal.
RestartPreventExitStatus=78

# --- Console access for kmsdrm ---
# systemd starts this with no controlling terminal and no logind seat, so
# without a TTY attached SDL's kmsdrm backend cannot become DRM master and the
# panel stays black while the process looks healthy. Do not remove these.
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes

# --- Hardening ---
# PROVISIONAL until hardware check H1. Sandboxing a process that talks to
# /dev/dri directly is exactly where these break. Any directive that stops the
# panel rendering is removed, and the removal recorded in docs/hardware-checks.md
# with the symptom that justified it.
# MemoryDenyWriteExecute is deliberately absent: SDL and its drivers map
# executable pages, and denying that would trade a working panel for a
# checkbox.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/scoreboard
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
DeviceAllow=char-drm rw
DeviceAllow=char-input r
DeviceAllow=/dev/tty1 rw

[Install]
WantedBy=multi-user.target
