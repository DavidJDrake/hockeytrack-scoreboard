# The health unit (design 5.2). On a trial boot it waits up to 240 s for
# scoreboard.service to connect to the broker and finish its first render
# pass, then commits by swapping autoboot.txt on SETUP, or reboots into the
# old slot. On the boot after a trial it has the trial slot's boot head
# zeroed and attributes the trial: the version's fault, or a pulled plug.
# On every other boot it exits at once. Its one other write is a torn
# autoboot.txt found while running the trial slot without the flag: it is
# rewritten to name the old slot before the reboot, because a reboot with
# the file torn walks straight back onto the trial slot, and that rollback
# is asked for once per record and never looped.
#
# Started early and independent of scoreboard.service: no After= on it,
# because the thing it judges may not start, and a trial boot the unit
# cannot decide is a rollback, never an exit.

[Unit]
Description=Decide a scoreboard trial boot
# The records live on STATE (bound at /var/lib/scoreboard-update) and
# autoboot.txt on SETUP, both nofail mounts (design 4.3). A nofail mount is
# NOT ordered before local-fs.target (systemd.mount(5)), so waiting for that
# target could run this unit against empty mount points during a slow fsck
# and roll back a good trial. Wait for the mount jobs themselves instead, as
# scoreboard.service does: After= waits for each job to end however it ends,
# and a mount that failed is then a rollback here rather than a hang.
After=boot-setup.mount state.mount var-lib-scoreboard\x2dupdate.mount

[Service]
Type=oneshot
WorkingDirectory=/opt/scoreboard
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/scoreboard/.venv/bin/python -m scoreboard.update health
# Above the 240 s health bound with room for the commit and its read-back.
TimeoutStartSec=300

# --- Hardening (design 5.2, 7.1) ---
# PROVISIONAL until hardware check H16. Those two paths are all it needs: it
# reads and writes the records and autoboot.txt and never the identity. No
# network at all; path-based unix sockets such as D-Bus cross the network
# namespace, so systemctl still works.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ReadWritePaths=/boot/setup /var/lib/scoreboard-update
InaccessiblePaths=/state /var/lib/scoreboard
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
CapabilityBoundingSet=
DevicePolicy=closed
UMask=077
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
