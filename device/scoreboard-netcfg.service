# Applies device/config-free Wi-Fi settings left on the boot partition, then
# removes them from it. Runs on every boot, not just the first: this is the
# only way to change a panel's network from a Windows or Mac machine, because
# NetworkManager keeps its connections on the ext4 root partition that neither
# can read.

[Unit]
Description=Apply scoreboard Wi-Fi settings from the boot partition
After=NetworkManager.service
Wants=NetworkManager.service
Before=scoreboard.service

[Service]
Type=oneshot
RemainAfterExit=no
WorkingDirectory=/opt/scoreboard
ExecStart=/opt/scoreboard/.venv/bin/python -m scoreboard.netcfg
# Runs as root: it writes a NetworkManager system connection, sets the Wi-Fi
# regulatory domain through raspi-config, and rewrites a file on the boot
# partition. It is seconds at boot, not a resident service, and it exits 0
# even when the file is wrong so a typo cannot stop the panel starting.
#
# Stated rather than inherited, because this unit is Before=scoreboard.service
# and so every second it takes is a second the panel shows nothing.
#
# netcfg ENFORCES its own budget rather than adding one up. BOOT_BUDGET_S in
# device/scoreboard/netcfg.py is a single monotonic deadline, created once and
# threaded through every step; each nmcli call, and raspi-config, is given
# timeout=min(its own cap, time remaining), and every loop re-checks the
# deadline after a call returns rather than only before one. So the ceiling is
# the number, by construction:
#
#   raspi-config setting the regulatory domain  QUERY_TIMEOUT_S    10 s
#   waiting for the Wi-Fi device to be usable   WIFI_READY_S       12 s
#   waiting for the network to be scanned       SCAN_BUDGET_S      15 s
#   one full connect                            CONNECT_TIMEOUT_S  45 s
#                                 BOOT_BUDGET_S                    ----
#                                                                  82 s
#
# Retries and their back-offs are not extra time: they only happen after a
# connect that failed instantly, so they spend what the first attempt did not.
#
# This briefly said "87 s", and that was an intention rather than a bound. It
# left out radio_on() and the rescans -- a capped nmcli call each -- and it
# counted the device wait as six two-second sleeps when each of those six
# iterations first ran a query that could take QUERY_TIMEOUT_S on its own.
# Worked through honestly that version could reach about 195 s: past this very
# timeout, so systemd would have killed the unit rather than the budget
# stopping it. device/tests/test_netcfg.py now runs the whole path with every
# call hanging to its kill and asserts the wall clock.
#
# 82 s is inside the "up to a minute and a half" that the download page and
# the setup steps promise an owner watching a dark panel.
#
# 120 s rather than 90 leaves 38 s above the enforced budget for systemd's own
# overhead, and keeps a slow connect from being killed part-way through, which
# would leave the setup file looking as though it had been ignored.
# device/tests/test_pi_setup.py asserts that headroom.
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
