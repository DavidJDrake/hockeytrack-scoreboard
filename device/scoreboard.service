# A template: tools/pi-setup.sh fills in the service user and the checkout
# path, then installs the result. Raspberry Pi OS has had no default "pi"
# account since 2022, so neither can be hardcoded here.

[Unit]
Description=HockeyTrack scoreboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@DEVICE_DIR@
Environment=SDL_VIDEODRIVER=kmsdrm
# Same reason as the appliance unit: this runs the same program, which plays
# no sound, and pygame.init() initializes the mixer anyway -- so ALSA prints
# about fifteen "cannot find card '0'" lines into the journal on every start.
# A developer's Pi has no sound hardware either, and the same 3-second
# restart loop buries the same failures under the same noise.
Environment=SDL_AUDIODRIVER=dummy
# Same reason as the appliance unit, and the same two variables: SDL emulates
# a non-OpenGL window surface with a 2D renderer (SDL_video.c:230, 2.32.4),
# tries "opengl" before "opengles2" when nothing names one (SDL_render.c:100),
# and a Pi whose apt line brings no libGL.so.1 -- which is this one, see
# tools/pi-setup.sh -- fails that attempt in a way that tears the kmsdrm
# window down and rebuilds it twice, leaving the panel black while the program
# draws happily. The appliance unit carries the full reasoning.
#
# It belongs here too rather than only on the image: this template is what a
# developer's Pi runs, and hardware checks H1, H3 and H7 are run through it
# against the same SDL and the same vc4/v3d stack. Two units that render
# differently would make those checks say nothing about the image.
Environment=SDL_FRAMEBUFFER_ACCELERATION=opengles2
Environment=SDL_RENDER_DRIVER=opengles2
Environment=PYTHONUNBUFFERED=1
# Same as the appliance unit: where the program leaves its status file and
# health marker for the updater's units. A checkout has no updater, but the
# program writes them regardless and the directory must exist for it to.
RuntimeDirectory=scoreboard
RuntimeDirectoryMode=0755
ExecStart=@DEVICE_DIR@/.venv/bin/python -m scoreboard.main
Restart=always
RestartSec=3
# 78 is EX_CONFIG, which the service exits with when a restart cannot help --
# chiefly a pygame whose SDL has no kmsdrm driver. Stop and leave the reason
# at the bottom of `journalctl -u scoreboard` instead of looping every 3 s.
RestartPreventExitStatus=78

# --- Console access for kmsdrm ---
# systemd starts this unit with no controlling terminal and no logind seat
# (it's not a login session), so without a TTY attached SDL's kmsdrm
# backend cannot become DRM master and the panel stays black on boot even
# though the process is up and "running". Binding the unit to the physical
# console fixes that; do not remove these thinking they're leftover cruft.
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
# Clear/reset the VT on each (re)start so a previous crash can't leave the
# console in a state that blocks the next DRM-master grab.
TTYReset=yes
TTYVHangup=yes

# Also requires the service user to be in the video and render groups, or
# opening /dev/dri fails with a permission error (kmsdrm talks to the DRM
# device directly -- there's no X server here to grant access instead).
# tools/pi-setup.sh adds them.

[Install]
WantedBy=multi-user.target
