{
 "about": "The config document, written by Go and read by Python. cloud/internal/panelconfig's test composes each case and must get `document` byte for byte; device/tests/test_config_documents.py feeds `document` to the panel's own parsers and must get `panelReads`. The wire format has one author and one reader, in two languages, and this file is what holds them to each other.",
 "cases": [
  {
   "name": "a game, a stamp and every setting",
   "compose": {
    "gameId": 2026020001,
    "chosenAt": 1789871240471,
    "account": {},
    "panel": {
     "countdownLeadMin": 120,
     "sleep": {
      "enabled": true,
      "start": "23:00",
      "end": "07:00",
      "zone": "America/Toronto"
     }
    }
   },
   "document": "{\"gameId\":2026020001,\"chosenAt\":1789871240471,\"display\":{\"v\":1,\"countdownLeadMin\":120,\"finalHoldMin\":180,\"sleep\":{\"start\":\"23:00\",\"end\":\"07:00\",\"zone\":\"America/Toronto\"}}}",
   "panelReads": {
    "gameId": 2026020001,
    "chosenAt": 1789871240471,
    "countdownLeadS": 7200,
    "finalHoldS": 10800,
    "sleep": [
     "23:00",
     "07:00",
     "America/Toronto"
    ]
   }
  },
  {
