.venv/
build/
device/config/
device/.venv/
.terraform/
terraform/.terraform/
terraform/*.tfvars
terraform/*.tfplan
terraform/*.tfstate
terraform/*.tfstate.*
.terraform.tfstate.lock.info
*.pyc
__pycache__/
*.pem
*.key
# Public root CA, pinned at build time and committed on purpose -- see
# device/scoreboard/identity.py. Nothing else certificate-shaped is.
!device/certs/AmazonRootCA1.pem
.playwright-mcp/

# Written by `make site-config` from terraform outputs. Nothing in it is a
# secret -- the API URL, the Cognito domain and a public client ID -- but a
# generated file does not belong in version control.
site/config.json
